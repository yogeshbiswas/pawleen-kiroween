# Copy to .env and fill in. Never commit .env.
# Model names below are examples verified on 2026-11-21 (see docs/openai-findings.md).
# Check the OpenAI docs again before relying on them; models get retired.

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
OPENAI_VISION_MODEL=gpt-6-luna

# Allowed: low, medium, high (the API also accepts xhigh, max, auto; this app does not use them). Default: medium.
OPENAI_IMAGE_QUALITY=medium

# Judge pass: leave empty to turn judge mode off. If set, it must be at least 16 random characters; a shorter pass turns judge mode off.
JUDGE_PASS=

# Daily limits (UTC day).
VISITOR_DAILY_LIMIT=3
JUDGE_DAILY_LIMIT=20
GLOBAL_DAILY_CAP=100

# Dev only: use fake agents (no OpenAI calls, no cost). Keep this off in production.
# USE_FAKE_AGENTS=1

# Use 127.0.0.1 on your own computer so other people on the same Wi-Fi cannot reach the app; Render uses 0.0.0.0
HOST=127.0.0.1
